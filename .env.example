# Copy to .env and fill in. `npm run dev` loads .env automatically if it exists.

# --- Required ---------------------------------------------------------------

# Which model provider to use: gemini (default) or groq.
# LLM_PROVIDER=gemini

# Gemini API key from Google AI Studio. Required when LLM_PROVIDER=gemini.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq API key. Required when LLM_PROVIDER=groq. With Gemini, if this is set,
# a call that hits Gemini's quota (429) is retried once on Groq.
# https://console.groq.com/keys
GROQ_API_KEY=

# Tavily API key: the agent's one tool, web search. https://app.tavily.com
TAVILY_API_KEY=

# --- Optional ---------------------------------------------------------------

# Fast model: plans each turn and extracts claims after the reply.
# Default gemini-3.5-flash-lite, or openai/gpt-oss-20b with Groq.
# MODEL_FAST=gemini-3.5-flash-lite

# Strong model: writes the streamed, cited answer.
# Default gemini-3.8-flash, or openai/gpt-oss-120b with Groq.
# MODEL_SMART=gemini-3.8-flash

# Pin the clock (ISO 8601). Makes "last Tuesday" resolve the same way every run,
# which evals and the seed script rely on. Leave unset in normal use.
# NOW=2026-11-11T09:00:00Z

# HTTP port. Defaults to 3000.
# PORT=3000

# Print per-stage timings (plan, recall, search, first token, total) to stderr.
# NODE_DEBUG=tally
